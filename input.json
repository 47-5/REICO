{
  "nproc": 8,
  "merged": "all.extxyz",
  "merged_format": "extxyz",
  "outdir": "reico_out",
  "format": "cif",
  "seed": 1103,

  "sampling_mode": "incremental",
  "enable_position_stats": false,
  "check_max_nn": false,

  "cell_angle_range": {
    "alpha": [60, 120],
    "beta":  [60, 120],
    "gamma": [60, 120]
  },

  "cell_length_ratio_range": [0.5, 2],

  "PtO-bulk": {
    "mix": { "Pt": [1, 12], "O": [1, 12] },
    "vacuum": 0,
    "numbers": 2000
  },

  "PtO-surface": {
    "mix": { "Pt": [1, 12], "O": [1, 12] },
    "vacuum": 8,
    "numbers": 2000
  },

  "PtO-ad": {
    "ad": {
      "base": { "Pd": [4, 16] },
      "adsorption": { "O": [1, 6] }
    },
    "vacuum": 8,
    "numbers": 2000
  },

  "PtCO-ad": {
    "ad": {
      "base": { "Pd": [4, 16] },
      "adsorption": { "O": [1, 6] , "C": [1, 6]}
    },
    "vacuum": 8,
    "numbers": 2000
  },

  "CO-cluster": {
    "cluster": { "C": [1, 3], "O": [1, 6] },
    "vacuum": 8,
    "numbers": 1000
  },

  "CHO-cluster": {
    "cluster": { "C": [1, 5], "O": [1, 6], "H": [2, 10] },
    "vacuum": 8,
    "numbers": 1000
  }
}