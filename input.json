{
  "nproc": 8,
  "output": "random_structure.extxyz",
  "outdir": "reico_out",
  "format": "extxyz",
  "seed": 1103,

  "sampling_mode": "incremental",
  "enable_position_stats": true,
  "check_max_nn": true,

  "cell_angle_range": {
    "alpha": [75, 105],
    "beta":  [75, 105],
    "gamma": [75, 105]
  },

  "cell_length_ratio_range": [0.8, 1.25],

  "PtO-bulk": {
    "mix": { "Pt": [1, 12], "O": [1, 12] },
    "vacuum": 0,
    "numbers": 200
  },

  "PtO-surface": {
    "mix": { "Pt": [1, 12], "O": [1, 12] },
    "vacuum": 8,
    "numbers": 200
  },

  "PtO-ad": {
    "ad": {
      "base": { "Pd": [4, 16] },
      "adsorption": { "O": [1, 6] }
    },
    "vacuum": 8,
    "numbers": 200
  },

  "CO-cluster": {
    "cluster": { "C": [1, 3], "O": [1, 6] },
    "vacuum": 8,
    "numbers": 100
  }
}