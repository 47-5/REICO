{
  "nproc": 8,
  "merged": "all.extxyz",
  "merged_format": "extxyz",
  "outdir": "reico_out",
  "format": "cif",
  "seed": 1103,

  "sampling_mode": "incremental",
  "enable_position_stats": false,
  "check_max_nn": false,

  "cell_angle_range": {
    "alpha": [60, 120],
    "beta":  [60, 120],
    "gamma": [60, 120]
  },

  "cell_length_ratio_range": [0.8, 1.5],

  "SiO-bulk": {
    "mix": { "Si": [1, 12], "O": [1, 12] },
    "vacuum": 0,
    "numbers": 2000
  },

  "GaO-bulk": {
    "mix": { "Ga": [1, 12], "O": [1, 12] },
    "vacuum": 0,
    "numbers": 2000
  },

  "GaSiO-bulk": {
    "mix": { "Ga": [1, 12], "O": [1, 12], "Si": [1,12] },
    "vacuum": 0,
    "numbers": 2000
  },

  "GaSiOH-bulk": {
    "mix": { "Ga": [1, 8], "O": [1, 8], "Si": [1, 8], "H": [1, 8]},
    "vacuum": 0,
    "numbers": 2000
  },

  "GaO-surface": {
    "mix": { "Ga": [1, 12], "O": [1, 12] },
    "vacuum": 8,
    "numbers": 2000
  },

  "GaH-surface": {
    "mix": { "Ga": [1, 12], "H": [1, 12] },
    "vacuum": 8,
    "numbers": 2000
  },

  "GaOH-surface": {
    "mix": { "Ga": [1, 12], "O": [1, 12], "H": [1, 12] },
    "vacuum": 8,
    "numbers": 2000
  },

  "SiO-GaOH-ad": {
    "ad": {
      "base": { "Si": [4, 12], "O": [4, 12] },
      "adsorption": { "Ga": [1, 6], "H": [2, 6], "O": [2, 6] }
    },
    "vacuum": 8,
    "numbers": 4000
  },

  "GaO-SiOH-ad": {
    "ad": {
      "base": { "Ga": [4, 12], "O": [4, 12] },
      "adsorption": { "Si": [1, 6], "H": [2, 6], "O": [2, 6] }
    },
    "vacuum": 8,
    "numbers": 4000
  },

  "CO-cluster": {
    "cluster": { "C": [1, 3], "O": [1, 6] },
    "vacuum": 8,
    "numbers": 1000
  },

  "CHO-cluster": {
    "cluster": { "C": [1, 5], "O": [1, 6], "H": [2, 10] },
    "vacuum": 8,
    "numbers": 1000
  }
}